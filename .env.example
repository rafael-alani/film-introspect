# App
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/introspect.db
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOW_SIGN_UP=true
# Prototype default: false bypasses the Introspect login, but never Jellyfin's API key.
APP_AUTH_ENABLED=false

# Jellyfin (server-side only)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_POLL_INTERVAL_MS=10000

# Bazarr is optional. Introspect reads subtitles through Jellyfin; Bazarr manages them.
BAZARR_URL=http://bazarr:6767
BAZARR_API_KEY=

# OMDb is an optional metadata fallback. The local Jellyfin file runtime wins.
OMDB_API_KEY=

# Useful for trying the UI before connecting Jellyfin.
DEMO_MODE=false

# Compose / reverse-proxy defaults
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
